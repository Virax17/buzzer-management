{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-pseudo-element-no-unknown": [true, { "ignorePseudoElements": ["ng-deep"] }],
    "selector-type-no-unknown": [true, { "ignoreTypes": ["/^app-/"] }],
    "declaration-no-important": true,
    "color-named": "never",
    "max-nesting-depth": 3
  }
}
